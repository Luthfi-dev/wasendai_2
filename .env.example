# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MULTI-HOST NODE IDENTITY (Required when running multiple app instances sharing one MySQL DB)
APP_ID="app01"

# APPLICATION SECURITY (Required in Production)
SESSION_SECRET="change_this_to_a_long_random_64_char_secret"
APP_ENCRYPTION_KEY="change_this_to_a_long_random_encryption_key"
SUPERADMIN_MASTER_PIN=""
ALLOWED_ORIGINS=""

# DATABASE CONFIGURATION (MYSQL CLOUD & LOCAL)
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
MYSQL_SSL="false"
MYSQL_POOL_LIMIT="6"
